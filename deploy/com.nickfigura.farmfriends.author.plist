<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Author agent. Every 10 minutes it takes at most one open work order, patches a
  staging copy of the tree (mechanically where the fix is deterministic, via the
  Glean llm_proxy gateway where it needs judgement), runs the full release gate
  matrix, and publishes under a self-reverting canary.

  IMPORTANT: executable code comes from the immutable release like every other
  service, while FARM_PROJECT_ROOT explicitly identifies the editable checkout.
  The author packages its gated worktree through the canonical deploy/release.sh;
  it never writes into the release from which it is running.

  Cadence is only an upper bound on attention. farm/rules.py defines a normal
  exploration quota plus an autonomous, bounded surge pool for priority repairs
  and aged backlog. The dollar ceiling, minimum run interval, and rule that no new
  pass starts while a canary watches the last one remain hard. Most invocations
  exit immediately.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nickfigura.farmfriends.author</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-u</string>
    <string>__PROJECT__/release/experiments/author_agent.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT__/release</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FARM_PROJECT_ROOT</key>
    <string>__PROJECT__</string>
  </dict>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT__/state/author.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/state/author.log</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
