<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The supervisor. Runs every 60s and is deliberately cheap: it makes no farm
  calls unless the main loop has gone stale. Its jobs are to keep the cycle
  agent loaded, remediate recurring alerts in Python, and book token cost.

  It is a separate agent from the cycle on purpose: each one repairs the other,
  so stopping the system takes two deliberate actions rather than one accident.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nickfigura.farmfriends.supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-u</string>
    <string>__PROJECT__/release/run.py</string>
    <string>--supervise</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT__/release</string>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT__/state/supervisor.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/state/supervisor.log</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
