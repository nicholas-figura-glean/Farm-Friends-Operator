<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  One-shot outage recovery watcher. Every 30 minutes it makes one leaderboard
  call while production is stalled. A strictly positive lifetime-score delta
  kickstarts the normal cycle; after recording recovery, later runs are inert.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nickfigura.farmfriends.recovery</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-u</string>
    <string>__PROJECT__/release/experiments/recovery_watch.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT__/release</string>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT__/state/recovery_watch.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/state/recovery_watch.log</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
