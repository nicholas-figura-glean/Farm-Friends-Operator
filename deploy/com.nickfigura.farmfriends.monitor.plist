<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Browser-facing dashboard server. Unlike the periodic dashboard agent, this is a
  long-running normal-priority process: it serves the page and APIs at
  http://127.0.0.1:8765.

  This service exists because monitor.py used to be hand-started. It survived eight
  releases and served an eight-hour-old, seven-tab page while the dashboard agent
  reported 5/5 green by testing fresh Python functions in a different process.
  KeepAlive makes a crash visible and recoverable; release.sh kickstarts this job after
  the atomic pointer flip so module-level HTML and routes always come from that release.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nickfigura.farmfriends.monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-u</string>
    <string>__PROJECT__/release/monitor.py</string>
    <string>--no-open</string>
    <string>--port</string>
    <string>8765</string>
    <string>--strict-port</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT__/release</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT__/state/monitor.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/state/monitor.log</string>
</dict>
</plist>
