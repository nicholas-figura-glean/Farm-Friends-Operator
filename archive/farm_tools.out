{"jsonrpc":"2.0","id":2,"result":{"tools":[{"name":"list_farm","description":"Show everything on your farm: animals and their moods, fields, barn inventory, coins, and open trades. Start here.","inputSchema":{"type":"object","properties":{}}},{"name":"collect_produce","description":"Gather eggs, milk, truffles, wool, and honey that your animals have produced since you last collected.","inputSchema":{"type":"object","properties":{}}},{"name":"feed_animals","description":"Feed your animals so they stay happy and keep producing. Hungry animals (hunger 70+) stop producing.","inputSchema":{"type":"object","properties":{"animal_id":{"type":"string","description":"Animal id number, or 'all' (default) to feed everyone hungry"}}}},{"name":"adopt_animal","description":"Adopt a new animal. Costs coins: chicken 10, pig 20, sheep 20, beehive 25, cow 30.","inputSchema":{"type":"object","required":["kind"],"properties":{"kind":{"type":"string","enum":["chicken","cow","pig","sheep","beehive"]},"name":{"type":"string","description":"Optional name. A cute one is chosen if omitted."}}}},{"name":"name_animal","description":"Rename one of your animals.","inputSchema":{"type":"object","required":["animal_id","name"],"properties":{"animal_id":{"type":"integer"},"name":{"type":"string"}}}},{"name":"plant","description":"Plant a field. wheat (4 coins, 15 min), corn (5 coins, 20 min), pumpkin (8 coins, 30 min), or wildflowers (3 coins, permanent, makes your beehives produce more honey).","inputSchema":{"type":"object","required":["kind"],"properties":{"kind":{"type":"string","enum":["wheat","corn","pumpkin","wildflowers"]}}}},{"name":"harvest","description":"Harvest every crop that has finished growing.","inputSchema":{"type":"object","properties":{}}},{"name":"sell","description":"Sell produce at the market for coins. Prices: egg 2, wheat 2, corn 3, wool 4, milk 5, honey 6, pumpkin 6, truffle 8.","inputSchema":{"type":"object","required":["item"],"properties":{"item":{"type":"string","enum":["egg","milk","truffle","wool","honey","wheat","corn","pumpkin"]},"qty":{"type":"integer","description":"How many to sell. Omit to sell all of that item."}}}},{"name":"buy_feed","description":"Buy animal feed, 1 coin each.","inputSchema":{"type":"object","properties":{"qty":{"type":"integer","description":"Default 10"}}}},{"name":"gift","description":"Send produce, feed, or coins to another farmer's farm as a gift. No strings attached.","inputSchema":{"type":"object","required":["to","item","qty"],"properties":{"to":{"type":"string","description":"Their first name or @glean.com email"},"item":{"type":"string","description":"egg, milk, truffle, wool, honey, wheat, corn, pumpkin, feed, or coin"},"qty":{"type":"integer"}}}},{"name":"propose_trade","description":"Offer another farmer a trade: your items for theirs. They accept or decline with respond_to_trade.","inputSchema":{"type":"object","required":["to","offer_item","offer_qty","want_item","want_qty"],"properties":{"to":{"type":"string","description":"Their first name or email"},"offer_item":{"type":"string"},"offer_qty":{"type":"integer"},"want_item":{"type":"string"},"want_qty":{"type":"integer"}}}},{"name":"respond_to_trade","description":"Accept or decline a trade offer sent to you (or withdraw one you sent).","inputSchema":{"type":"object","required":["trade_id","accept"],"properties":{"trade_id":{"type":"integer"},"accept":{"type":"boolean"}}}},{"name":"farm_events","description":"Recent happenings on your farm: eggs laid, milk given, gifts received, hungry animals, and so on. Great for posting to Slack.","inputSchema":{"type":"object","properties":{"limit":{"type":"integer","description":"How many events, default 10, max 50"}}}},{"name":"leaderboard","description":"Rank all farms in the lab by lifetime produce.","inputSchema":{"type":"object","properties":{}}},{"name":"visit_farm","description":"Peek at another farmer's farm.","inputSchema":{"type":"object","required":["farmer"],"properties":{"farmer":{"type":"string","description":"Their first name or email"}}}}]}}